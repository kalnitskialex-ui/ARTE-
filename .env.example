# Скопируйте в .env и заполните.

# База: SQLite для старта, PostgreSQL для продакшена.
ARTE_DATABASE_URL=sqlite+aiosqlite:///./arte.db
# ARTE_DATABASE_URL=postgresql+asyncpg://arte:arte@localhost:5432/arte

# Как скачивать страницы: httpx | scrapling | firecrawl | browser
ARTE_FETCH_BACKEND=httpx
ARTE_SCRAPLING_MODE=http          # http | dynamic (для страниц на JavaScript)

# Firecrawl (https://firecrawl.dev) — облачный или self-hosted
ARTE_FIRECRAWL_API_KEY=
ARTE_FIRECRAWL_API_URL=
ARTE_FIRECRAWL_JSON_EXTRACT=true

# Вежливость к площадкам
ARTE_USER_AGENT=ARTE-bot/0.1 (+https://github.com/kalnitskialex-ui/ARTE-)
ARTE_PER_HOST_DELAY=3
ARTE_RESPECT_ROBOTS_TXT=true

# LLM-извлечение, когда на странице нет структурированных данных: claude | scrapegraph
ARTE_LLM_ENABLED=false
ARTE_LLM_BACKEND=claude
ARTE_LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Для ScrapeGraphAI можно указать другую модель: провайдер/модель, например ollama/llama3.1
ARTE_SCRAPEGRAPH_MODEL=

# Уведомления
ARTE_TELEGRAM_BOT_TOKEN=
ARTE_TELEGRAM_CHAT_ID=
